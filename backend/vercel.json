{
  "version": 2,
  "installCommand": "npm install && npx prisma generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/notifications/cron/rappels", "schedule": "0 18 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.ts" }]
}
